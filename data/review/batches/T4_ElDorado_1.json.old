        "single-family and condominium projects over 2,000 sq ft per unit (compliance)",
        "condo conversions (compliance)",
        "deed-restricted units at or below 120% AMI (exempt)",
        "long-term multifamily rental projects of two or more units (exempt)"
      ],
      "next_deadline_date": null,
