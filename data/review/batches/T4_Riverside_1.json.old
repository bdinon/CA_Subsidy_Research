      "program_name": "HACR housing successor funds and land dispositions (Low and Moderate Income Housing Asset Fund, DDLAs)",
      "administering_agency": "Housing Authority of the County of Riverside as housing successor to the former County and Coachella redevelopment agencies",
      "funding_type": "loan",
      "typical_award_size": "Villa Verde Apartments, Coachella (152 units in two phases, Abode Communities): amended and restated Disposition, Development and Loan Agreement (February 3, 2026) conveys HACR land with a Low and Moderate Income Housing Asset Fund loan of $4,404,640. Rubidoux Gateway Villas, Jurupa Valley (57 family units, National Housing Development Corporation): DDLA with a seller carryback loan equal to the purchase price (September 1, 2026). Camino Terrace, Jurupa Valley (80 units, Wakeland): DDLA and land sale (September 1, 2026). Tres Lagos Apartments Phase III, Wildomar: up to $1,200,000 and tax credit support (July 14, 2026). Housing successor balances at June 30, 2025: County successor (HASA) $460,089 and Coachella successor (CSA) $1,894,430, the latter pending release to Villa Verde in 2026.",
      "per_unit_cap": "Not published.",
      "affordability_requirement": "Housing successor rules (80% AMI and below, 30% extremely low income minimum over five years); DDLAs restrict 49% of non-manager units with HACR covenants, with PBVs on the balance.",
      "eligible_project_types": [
        "new construction"
      ],
      "application_cycle": "rolling",
      "next_deadline": "Sites are offered through exclusive negotiation agreements and DDLAs on a project basis; no open solicitation found. HACR files Section 33433 reports before each land sale.",
      "prevailing_wage_trigger": "true",
      "layering_notes": "Riverside County's Housing and Workforce Solutions (HWS) department runs the Urban County HUD programs, PLHA, HHAP, Homekey+ sponsorships and project loans, while the Housing Authority of the County of Riverside (HACR, same Board sitting as Commissioners) supplies project-based vouchers, housing successor funds and land; rivcohws.org and harivco.org block automated access, so records were built from Board of Supervisors files on riversidecountyca.iqm2.com and media.rivcocob.org, RUHS Behavioral Health, the Assessor and the County Housing Element. HACR behaves as a land bank: it holds former redevelopment parcels in Coachella, Jurupa Valley, Rubidoux and elsewhere and conveys them with a seller loan, PBVs and sometimes a Homekey+ sponsorship, which is how Villa Verde and Camino Terrace were assembled. Successor funds are small and mostly committed. Source is the February 3, 2026 Board of Commissioners file for the Villa Verde DDLA; successor balances from the FY 2024-25 Annual Housing Successor Report (Detail_LegiFile.aspx?ID=29600).",
      "source_url": "https://riversidecountyca.iqm2.com/Citizens/Detail_LegiFile.aspx?ID=29134",
      "record_id": "27b8a4bdfc",
      "cycle_notes": "",
      "eligible_project_detail": [
        "new construction on HACR-owned land",
        "ground lease or land sale with seller loan",
        "tax credit projects needing local land and soft debt"
      ],
      "next_deadline_date": null,
      "deadline_check": "no_date",
      "link_status": "ok"
    }
