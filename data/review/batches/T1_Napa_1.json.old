      ],
      "next_deadline_date": null,
      "deadline_check": "no_date",
      "link_status": "ok",
      "audit_note": "Zoneomics mirror of Chapter 18.107 was re-read and matches the record (18.107.180(F) 55-year rental, (G) 45-year for-sale; 18.107.190 defers to state law), but it is a third-party mirror. library.municode.com and napacounty.gov return Cloudflare challenges, and the Ordinance 1495 attachments on napa.legistar.com returned 404, so the official code text could not be opened.",
      "last_audited": "2026-11-08"
