      "program_name": "Tax-exempt multifamily bonds: County TEFRA approvals for CMFA issuances (County not an issuer)",
      "administering_agency": "Marin County Board of Supervisors (TEFRA hearings) with the County Executive and Community Development Agency; bonds issued by the California Municipal Finance Authority",
      "funding_type": "bond",
      "typical_award_size": "The County holds TEFRA hearings as the CMFA member jurisdiction but does not issue bonds or take on liability: Golden Gate Village Phase 1, up to $50,000,000 (hearing and resolution Oct 14, 2025; CDLAC allocation $41,748,341); Golden Gate Village Phase 2, up to $160,000,000 (hearing Oct 20, 2026). Other Marin deals through CMFA include Centertown II in San Rafael ($18,442,396) and a $30,075,000 acquisition issue; a 2023 Marin City bond approval drew a lawsuit against the County and CMFA. Marinwood Plaza (125 units, 124 restricted) used CalHFA's Mixed-Income Program (April 2026).",
      "per_unit_cap": null,
      "affordability_requirement": "CDLAC and Section 142(d) minimums under the issuer's regulatory agreement; County loans in the same project add County covenants (Golden Gate Village units stay public housing or PBV-assisted under RAD).",
      "eligible_project_types": [
        "new construction",
        "acquisition-rehab",
        "preservation"
      ],
