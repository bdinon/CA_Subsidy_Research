      "program_name": "Behavioral Health Services Act (BHSA) Integrated Plan FY 2026-29, housing interventions",
      "administering_agency": "Riverside University Health System, Behavioral Health (RUHS-BH)",
      "funding_type": "other",
      "typical_award_size": "BHSA component allocations of $195,334,844 a year; housing interventions set at 23% in year one ($44,927,014) and 27% in years two and three ($52,740,408) after a transfer to other components, with estimated year one housing expenditures of $44,225,982. Plan adopted by the Board June 2, 2026. Uses are tenant-based rental subsidies for about 6,015 people a year (1,015 permanent, 5,000 interim) and operating subsidies for about 725 people in PSH, assisted living and interim settings; no BHSA capital development (the County reports housing funds fully subscribed and points to 399 new interim and recuperative care units at the Mead Valley Wellness Village opening 2027). RUHS-BH housing vendor purchase orders were raised to $15,000,000 a year through FY 2030-31.",
      "per_unit_cap": "Not applicable; no capital program.",
      "affordability_requirement": "BHSA-eligible adults with serious behavioral health conditions who are homeless or at risk, at least 50% chronically homeless, Housing First.",
      "eligible_project_types": [
        "supportive housing",
        "interim housing",
        "services/operations"
      ],
      "application_cycle": "rolling",
      "next_deadline": "Three-year plan effective July 1, 2026 with annual updates each spring; RUHS-BH contracts with housing vendors through purchase orders rather than a developer NOFA.",
      "prevailing_wage_trigger": "false",
      "layering_notes": "Riverside County's Housing and Workforce Solutions (HWS) department runs the Urban County HUD programs, PLHA, HHAP, Homekey+ sponsorships and project loans, while the Housing Authority of the County of Riverside (HACR, same Board sitting as Commissioners) supplies project-based vouchers, housing successor funds and land; rivcohws.org and harivco.org block automated access, so records were built from Board of Supervisors files on riversidecountyca.iqm2.com and media.rivcocob.org, RUHS Behavioral Health, the Assessor and the County Housing Element. Unlike several Bay Area counties, Riverside chose tenant-based subsidies and operating support over project-based commitments and zero capital, so BHSA is not a construction source here; developers of PSH should seek RUHS-BH operating subsidy or master lease vendor agreements for behavioral health units and pair them with HACR PBVs. Source is the DHCS Integrated Plan submission (RUHS media 5601); executive brief at ruhealth.org/media/5971; Board adoption file Detail_LegiFile.aspx?ID=30512.",
      "source_url": "https://www.ruhealth.org/media/5601",
      "record_id": "b9c5d9af17",
      "cycle_notes": "",
      "eligible_project_detail": [
        "tenant-based rental subsidies (not project-based)",
        "operating subsidies for PSH and licensed settings",
        "interim housing operations"
      ],
      "next_deadline_date": "2026-07-01",
      "deadline_check": "past_date",
      "link_status": "ok"
    }
